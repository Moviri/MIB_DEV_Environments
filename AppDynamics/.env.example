# Copy to .env. Defaults run the demo without AppDynamics.
DEMO_PORT=8088
DEMO_BIND_ADDRESS=127.0.0.1
DB_PASSWORD=capital-local-only
DEMO_FAILURES_ENABLED=true

APPDYNAMICS_ENABLED=false
APPDYNAMICS_CONTROLLER_HOST_NAME=
APPDYNAMICS_CONTROLLER_PORT=443
APPDYNAMICS_CONTROLLER_SSL_ENABLED=true
APPDYNAMICS_AGENT_ACCOUNT_NAME=
APPDYNAMICS_AGENT_ACCOUNT_ACCESS_KEY=
APPDYNAMICS_AGENT_APPLICATION_NAME=Capital-Lab
# Use a different ID on each Docker host. All JVMs on one host share its ID.
APPDYNAMICS_AGENT_UNIQUE_HOST_ID=capital-lab-windows-docker

# cycle rotates normal / peak / slow / errors / recovery every 5 minutes.
LOAD_RPS=2
LOAD_WORKERS=8
LOAD_PATTERN=cycle
LOAD_PHASE_SECONDS=300
# 0 runs until stopped; otherwise stop issuing requests after this duration.
LOAD_DURATION_SECONDS=0
